includes:
    - %rootDir%/../phpstan-deprecation-rules/rules.neon
    - %rootDir%/../phpstan-strict-rules/rules.neon
    - %rootDir%/../phpstan/conf/bleedingEdge.neon

parameters:
    paths:
        - src
        - tests
    featureToggles:
    	rawMessageInBaseline: true
    level: 8
    excludePaths:
        # These test fixtures *could* be streamlined but currently generate lots of failures
        - tests/Functional/Fixtures
        - tests/Unit/Php/Matcher
        - tests/Unit/Php/Visitor/Fixtures
    strictRules:
        allRules: false
        booleansInConditions: false
        closureUsesThis: true
        disallowedLooseComparison: true
        matchingInheritedMethodNames: true
        noVariableVariables: false
        numericOperandsInArithmeticOperators: true
        overwriteVariablesWithLoop: true
        requireParentConstructorCall: true
        switchConditionsMatchingType: true
        uselessCast: true
    tmpDir: %rootDir%/../../../var/cache/phpstan
    treatPhpDocTypesAsCertain: false
    inferPrivatePropertyTypeFromConstructor: true
